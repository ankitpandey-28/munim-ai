# Copy to .env for local development. Never commit real .env files.
# This file must contain placeholders only.

APP_NAME="Munim AI API"
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# Local native PostgreSQL (see infra/postgres/local-setup.sql and the root README).
# Replace CHANGE_ME with the passwords you set via \password. Use URL-safe passwords
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"); otherwise
# percent-encode special characters.

# Runtime connection: the low-privilege application role (munim_app).
# Must NOT be the migration/owner role or a superuser.
DATABASE_URL=postgresql+psycopg://munim_app:CHANGE_ME@localhost:5432/munim_ai

# Migration connection: the owner role (munim_owner). Used only by Alembic, never by the API.
MIGRATION_DATABASE_URL=postgresql+psycopg://munim_owner:CHANGE_ME@localhost:5432/munim_ai

# Seconds to wait for a database connection in health checks.
DATABASE_CONNECT_TIMEOUT=3

# Expected identities, verified against the live session after connecting (defaults shown).
# The health check reports role_check=unsafe and Alembic refuses to run if they don't match.
# DATABASE_NAME=munim_ai
# DATABASE_APP_ROLE=munim_app
# DATABASE_OWNER_ROLE=munim_owner

# ---- Authentication / sessions
# HMAC key for hashing phone numbers and IPs in login_attempts / audit logs.
# REQUIRED in production (>= 32 random characters). In development, leaving it unset uses a
# random per-process key (login lockout history then resets on restart).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=CHANGE_ME
# SESSION_COOKIE_NAME=munim_session
# Browsers accept Secure cookies on http://localhost, so keep this true unless testing with a
# non-browser client over plain http on another host.
# SESSION_COOKIE_SECURE=true
# SESSION_ABSOLUTE_TTL_HOURS=720
# SESSION_IDLE_TTL_HOURS=168
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_IP_MAX_ATTEMPTS=30
# REGISTRATION_IP_MAX_PER_HOUR=10

# ---- Browser access
# Origins allowed to make state-changing requests (CSRF origin check). Production: https only.
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS is not needed with the Next.js same-origin proxy; enable only for direct browser access.
# CORS_ENABLED=false
# X-Forwarded-For is trusted only from these peers (the Next.js server).
# TRUSTED_PROXY_IPS=127.0.0.1,::1
