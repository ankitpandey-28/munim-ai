# ---------- Secrets & local configuration ----------
# Real environment files must never be committed. Only *.env.example files are tracked.
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# ---------- Node / Next.js (frontend) ----------
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
.vercel

# ---------- Databases / data ----------
*.sqlite3
*.db
*.dump
*.sql
# Schema/role setup scripts are source code, not data dumps:
!infra/postgres/local-setup.sql
!infra/postgres/verify-roles.sql
pgdata/

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log
logs/

# ---------- Local database backups (may contain business data) ----------
backups/
