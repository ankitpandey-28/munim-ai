# Copy to infra/.env and replace every CHANGE_ME with a strong, unique value.
# Never commit infra/.env. Placeholders only in this file.
#
# Generate passwords, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bootstrap superuser (administration and first-run init only; never used by the app).
POSTGRES_SUPERUSER=munim_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_DB=munim

# Migration/owner role: owns schema objects; used only by Alembic (MIGRATION_DATABASE_URL).
MUNIM_OWNER_ROLE=munim_owner
MUNIM_OWNER_PASSWORD=CHANGE_ME

# Runtime application role: NOSUPERUSER NOBYPASSRLS, not an owner (DATABASE_URL).
MUNIM_APP_ROLE=munim_app
MUNIM_APP_PASSWORD=CHANGE_ME

# Host port bound on 127.0.0.1 only.
POSTGRES_HOST_PORT=5433
